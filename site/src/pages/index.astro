---
import Base from '../layouts/Base.astro';
---
<Base title="Meitou · Kenshi engine reimplementation" video>
  <section class="hero">
    <div class="stack">
      <h1>Run Kenshi on a new engine</h1>
      <p class="lede">
        <span class="name">Meitou<span>Client</span></span> is an open-source reimplementation of the original engine.
        Fully compatible with FCS mods and vanilla save games. Requires original copy to run
      </p>
    </div>
  </section>
</Base>

<style>
  /* Fills the first view below the header (150px), stack at the top left. */
  .hero { display: flex; align-items: flex-start; min-height: calc(100svh - 150px); padding: 48px 0 calc(var(--edge) + 24px); }
  .stack { min-width: 0; }
  h1 { margin: 0 0 var(--space-6); color: var(--paper-light); text-shadow: 0 2px 12px rgba(8, 6, 5, .6); white-space: nowrap; font: 600 clamp(32px, 6vw, 52px)/1.1 var(--font-exo); }
  .lede { max-width: 620px; margin: 0; font-size: 18px; line-height: 27px; text-shadow: 0 1px 8px rgba(8, 6, 5, .8); }
  /* The name set like the header wordmark: Meitou semibold, Client regular. */
  .name > span { font-weight: 400; }
  @media (max-width: 640px) { h1 { white-space: normal; } }
</style>
