---
import Base from '../layouts/Base.astro';
---
<Base title="Meitou · Kenshi engine reimplementation" video>
  <section class="hero">
    <div class="stack">
      <p class="eyebrow mt-caption">Meitou Engine</p>
      <h1>Run Kenshi on a new engine.</h1>
      <p class="lede">
        MeitouClient reimplements the engine to run original content, mods and saves unchanged.
        It reads the files of your installed copy and ships none of them.
      </p>
    </div>
  </section>
</Base>

<style>
  /* Fills the first view below the header (174px), stack at the bottom left like the main menu. */
  .hero { display: flex; align-items: flex-end; min-height: calc(100svh - 174px); padding: 72px 0 calc(var(--edge) + 24px); }
  .stack { max-width: 620px; }
  .eyebrow { margin: 0 0 var(--space-4); letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0 0 var(--space-6); color: var(--paper-light); text-shadow: 0 2px 12px rgba(8, 6, 5, .6); font: 600 clamp(32px, 6vw, 52px)/1.1 var(--font-exo); }
  .lede { margin: 0; font-size: 18px; line-height: 27px; }
</style>
