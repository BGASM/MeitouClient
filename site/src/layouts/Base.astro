---
import '@fontsource/exo-2/400.css';
import '@fontsource/exo-2/600.css';
import '../styles/meitou.css';

interface Props {
  title: string;
  description?: string;
  /** Loop the background video behind the first view. */
  video?: boolean;
}

const { title, description = 'MeitouClient: a .NET reimplementation of the Kenshi engine.', video = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <div class="mt-scene">
      {video && (
        <div class="bg" aria-hidden="true">
          <video autoplay muted loop playsinline preload="auto" poster="/bgvideo.jpg">
            <source src="/bgvideo.webm" type="video/webm" />
          </video>
        </div>
      )}
      <header class="top">
        <a class="brand" href="/">Meitou<span>Client</span></a>
        <a class="gh" href="https://github.com/VlcekM/MeitouClient">
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          GitHub
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot mt-caption">
        GPL-3.0-or-later · No game assets are distributed · Not affiliated with Lo-Fi Games
      </footer>
    </div>
    {video && (
      <script is:inline>
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector('.bg video')?.pause();
      </script>
    )}
  </body>
</html>

<style>
  /* First view: the video behind the header and hero. */
  .bg {
    position: absolute;
    inset: 0 0 auto;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }
  .bg video { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Slight vignette: darker corners, a band behind the header, a soft patch behind the hero text. */
  .bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 760px 380px at 18% 82%, rgba(8, 6, 5, .4), transparent 70%),
      linear-gradient(rgba(8, 6, 5, .45), transparent 120px),
      radial-gradient(ellipse at center, transparent 55%, rgba(8, 6, 5, .5) 100%);
  }
  .top, main, .foot { position: relative; }
  .top {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-6);
  }
  .brand {
    margin-right: auto;
    color: #fff;
    font: 600 24px/30px var(--font-exo);
    text-decoration: none;
  }
  .brand span { font-weight: 400; }
  .gh { display: inline-flex; align-items: center; gap: var(--space-4); color: #fff; font: 600 16px/21px var(--font-exo); text-decoration: none; opacity: .85; transition: opacity .16s ease; }
  .gh:hover { color: #fff; opacity: 1; }
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-7);
  }
  .foot {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-6) 36px;
  }
</style>
