---
import '@fontsource/exo-2/400.css';
import '@fontsource/exo-2/600.css';
import '../styles/meitou.css';

interface Props {
  title: string;
  description?: string;
  /** Loop the background video behind the first view. */
  video?: boolean;
}

const { title, description = 'MeitouClient: a .NET reimplementation of the Kenshi engine.', video = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <div class="mt-scene">
      {video && (
        <div class="bg" aria-hidden="true">
          <video autoplay muted loop playsinline preload="auto" poster="/bgvideo.jpg">
            <source src="/bgvideo.webm" type="video/webm" />
          </video>
        </div>
      )}
      <header class="top">
        <a class="brand" href="/">Meitou<span>Client</span></a>
        <a class="gh" href="https://discord.gg/DVAHH2n9DR">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          Discord
        </a>
        <a class="gh" href="https://github.com/VlcekM/MeitouClient">
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          GitHub
        </a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot mt-caption">
        GPL-3.0-or-later · No game assets are distributed · Not affiliated with Lo-Fi Games
      </footer>
    </div>
    {video && (
      <script is:inline>
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector('.bg video')?.pause();
      </script>
    )}
  </body>
</html>

<style>
  /* --frame: the page ground around the video; --edge: where content starts, just inside the frame. */
  .mt-scene { --frame: 36px; --edge: calc(var(--frame) + 24px); }

  /* First view: the video in a frame with rounded inner corners, behind the header and hero. */
  .bg {
    position: absolute;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    height: calc(100svh - 2 * var(--frame));
    overflow: hidden;
    border-radius: calc(4 * var(--radius-card));
    pointer-events: none;
  }
  .bg video { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Slight vignette: darker corners, a band behind the header, a soft patch behind the hero text. */
  .bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 760px 380px at 18% 82%, rgba(8, 6, 5, .4), transparent 70%),
      linear-gradient(rgba(8, 6, 5, .45), transparent 120px),
      radial-gradient(ellipse at center, transparent 55%, rgba(8, 6, 5, .5) 100%);
  }
  .top, main, .foot { position: relative; }
  .top {
    display: flex;
    align-items: center;
    gap: var(--space-7);
    flex-wrap: wrap;
    padding: var(--edge);
  }
  .brand {
    margin-right: auto;
    color: #fff;
    font: 600 24px/30px var(--font-exo);
    text-decoration: none;
  }
  .brand span { font-weight: 400; }
  .gh { display: inline-flex; align-items: center; gap: var(--space-4); color: #fff; font: 600 16px/21px var(--font-exo); text-decoration: none; opacity: .85; transition: opacity .16s ease; }
  .gh:hover { color: #fff; opacity: 1; }
  main { padding: 0 var(--edge); }
  .foot { padding: var(--space-7) var(--edge) 36px; }
</style>
