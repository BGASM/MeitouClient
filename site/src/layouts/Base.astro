---
import '@fontsource/exo-2/600.css';
import '../styles/meitou.css';

interface Props {
  title: string;
  description?: string;
  /** Loop the background video behind the first view. */
  video?: boolean;
}

const { title, description = 'MeitouClient: a .NET reimplementation of the Kenshi engine.', video = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <div class="mt-scene">
      {video && (
        <div class="bg" aria-hidden="true">
          <video autoplay muted loop playsinline preload="auto" poster="/bgvideo.jpg">
            <source src="/bgvideo.webm" type="video/webm" />
          </video>
        </div>
      )}
      <header class="top">
        <a class="brand" href="/">Meitou</a>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot mt-caption">
        GPL-3.0-or-later · No game assets are distributed · Not affiliated with Lo-Fi Games
      </footer>
    </div>
    {video && (
      <script is:inline>
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelector('.bg video')?.pause();
      </script>
    )}
  </body>
</html>

<style>
  /* First view: the video under the vignette, fading into the page ground below. */
  .bg {
    position: absolute;
    inset: 0 0 auto;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }
  .bg video { display: block; width: 100%; height: 100%; object-fit: cover; }
  .bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 900px 640px at 4% 80%, rgba(8, 6, 5, .85) 20%, rgba(8, 6, 5, .45) 55%, transparent 80%),
      linear-gradient(rgba(8, 6, 5, .55), rgba(8, 6, 5, .1) 22%, rgba(8, 6, 5, .2) 60%, var(--vignette));
  }
  .top, main, .foot { position: relative; }
  .top {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-6);
  }
  .brand {
    margin-right: auto;
    color: var(--paper-light);
    font: 600 24px/30px var(--font-exo);
    letter-spacing: .12em;
    text-transform: uppercase;
    text-decoration: none;
  }
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-7);
  }
  .foot {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-6) 36px;
  }
</style>
